# Copy to .env.local and fill in. Never commit real values.

# Database: the Neon branch you develop against (the post-drafting-mvp dev
# branch locally; main in production). Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth for the same branch: its base URL (Neon Console → Auth), and a
# random secret for the session cookie (`openssl rand -base64 32`).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# AI Gateway. On Vercel, OIDC authenticates instead (`vercel env pull` adds
# VERCEL_OIDC_TOKEN locally). AI_MODEL defaults to anthropic/claude-sonnet-5.5.
AI_GATEWAY_API_KEY=
# AI_MODEL=
# AI_MOCK=1   # mock model: no tokens spent (set automatically for E2E)

# Tests: the separate `test` Neon branch (database and Neon Auth), so tests
# never touch dev or production data.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
TEST_NEON_AUTH_BASE_URL=

# Playwright: a password user on the test branch (created on first run), and an
# email that isn't on the allowlist.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_BLOCKED_EMAIL=

# Vercel Protection Bypass for Automation: lets Neon's webhook reach protected
# preview deployments (`?x-vercel-protection-bypass=` on the webhook URL).
VERCEL_AUTOMATION_BYPASS_SECRET=
